{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "leader": "ctrl+o",
    "session.tab.next": "alt+l",
    "session.tab.previous": "alt+h",
    "session.tab.close": "<leader>x",
    "session.export": "none"
  },
  "plugins": ["@cortexkit/opencode-magic-context@0.49.0"],
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "theme": {
    "name": "tokyonight"
  },
  "session": {
    "sidebar": "hide",
    "verbosity": "medium",
    "thinking": "show"
  },
  "tabs": {
    "mode": "on",
    "layout": "horizontal",
    "indicators": "status"
  }
}
