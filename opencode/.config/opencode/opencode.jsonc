{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"edit": "ask",
		"read": {
			"*": "allow",
			"*.env": "ask",
			"*.env.*": "ask",
			"*.env.example": "allow"
		},
		"bash": {
			"*": "ask",

			// read related commands allowed
			"mkdir *": "allow",
			"cat *": "allow",
			"head *": "allow",
			"tail *": "allow",
			"less *": "allow",
			"more *": "allow",
			"nl *": "allow",
			"grep *": "allow",
			"rg *": "allow",
			"ls *": "allow",
			"find *": "allow",
			"wc *": "allow",
			"sort *": "allow",
			"uniq *": "allow",
			"which *": "allow",
			"type *": "allow",
			"pwd": "allow",
			"echo *": "allow",
			"printf *": "allow",
			"date": "allow",
			"whoami": "allow",
			"id": "allow",
			"uname *": "allow",
			"df *": "allow",
			"du *": "allow",
			"ps *": "allow",

			// formating commands
			"npx tsc --noEmit*": "allow",
			"npx biome*": "allow",
			"npx prettier*": "allow",
			"npx eslint*": "allow",
			"npx ruff*": "allow",
			"go fmt*": "allow",
			"cargo fmt*": "allow",
			"black*": "allow",
			"ruff format*": "allow",
			"rustfmt*": "allow",

			// read-only git commands
			"git log*": "allow",
			"git diff*": "allow",
			"git status*": "allow",
			"git show*": "allow",
			"git blame*": "allow",
			"git grep*": "allow",
			"git ls-files*": "allow",
			"git ls-tree*": "allow",
			"git ls-remote*": "allow",
			"git cat-file*": "allow",
			"git rev-list*": "allow",
			"git rev-parse*": "allow",
			"git describe*": "allow",
			"git shortlog*": "allow",
			"git reflog*": "allow",
			"git name-rev*": "allow",
			"git for-each-ref*": "allow",
			"git branch": "allow",
			"git branch --list*": "allow",
			"git tag": "allow",
			"git tag -l*": "allow",
			"git remote": "allow",
			"git remote -v*": "allow",
			"git remote show*": "allow",
			"git stash list": "allow",
			"git config --get*": "allow",
			"git config --list*": "allow",

			// env related commands
			"echo $*": "ask",
			"env": "ask",
			"printenv": "ask",
			"export": "ask",
			"set": "ask",

			// anything related with env files
			"*.env": "ask",
			"*.env.*": "ask",
			"*.env.example": "allow"
		}
	},
	"autoupdate": false,
	"plugin": [
		"@mohak34/opencode-notifier@latest",
		"@cortexkit/opencode-magic-context@0.34.0"
	],
	"mcp": {
		"supabase": {
			"type": "remote",
			"url": "http://127.0.0.1:54321/mcp",
			"enabled": false
		},
		"hound": {
			"type": "local",
			"command": ["hound"],
			"enabled": true
		}
	},
	"compaction": {
		"auto": false,
		"prune": false
	}
}
