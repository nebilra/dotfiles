{
	"$schema": "https://opencode.ai/config.json",

	// Ordered rules; the last match wins.
	"permissions": [
		// edit / read
		{ "action": "edit", "resource": "*", "effect": "ask" },
		{ "action": "read", "resource": "*", "effect": "allow" },
		{ "action": "read", "resource": "*.env", "effect": "ask" },
		{ "action": "read", "resource": "*.env.*", "effect": "ask" },
		{ "action": "read", "resource": "*.env.example", "effect": "allow" },

		// read-only shell commands
		{ "action": "shell", "resource": "*", "effect": "ask" },
		{ "action": "shell", "resource": "mkdir *", "effect": "allow" },
		{ "action": "shell", "resource": "cat *", "effect": "allow" },
		{ "action": "shell", "resource": "head *", "effect": "allow" },
		{ "action": "shell", "resource": "tail *", "effect": "allow" },
		{ "action": "shell", "resource": "less *", "effect": "allow" },
		{ "action": "shell", "resource": "more *", "effect": "allow" },
		{ "action": "shell", "resource": "nl *", "effect": "allow" },
		{ "action": "shell", "resource": "grep *", "effect": "allow" },
		{ "action": "shell", "resource": "rg *", "effect": "allow" },
		{ "action": "shell", "resource": "ls *", "effect": "allow" },
		{ "action": "shell", "resource": "find *", "effect": "allow" },
		{ "action": "shell", "resource": "wc *", "effect": "allow" },
		{ "action": "shell", "resource": "sort *", "effect": "allow" },
		{ "action": "shell", "resource": "uniq *", "effect": "allow" },
		{ "action": "shell", "resource": "which *", "effect": "allow" },
		{ "action": "shell", "resource": "type *", "effect": "allow" },
		{ "action": "shell", "resource": "pwd", "effect": "allow" },
		{ "action": "shell", "resource": "echo *", "effect": "allow" },
		{ "action": "shell", "resource": "printf *", "effect": "allow" },
		{ "action": "shell", "resource": "date", "effect": "allow" },
		{ "action": "shell", "resource": "whoami", "effect": "allow" },
		{ "action": "shell", "resource": "id", "effect": "allow" },
		{ "action": "shell", "resource": "uname *", "effect": "allow" },
		{ "action": "shell", "resource": "df *", "effect": "allow" },
		{ "action": "shell", "resource": "du *", "effect": "allow" },
		{ "action": "shell", "resource": "ps *", "effect": "allow" },
		{
			"action": "shell",
			"resource": "pnpm exec tsc --noEmit*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "pnpm exec biome*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "pnpm exec prettier*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "pnpm exec eslint*",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "pnpm exec ruff*", "effect": "allow" },
		{
			"action": "shell",
			"resource": "npx tsc --noEmit*",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "npx biome*", "effect": "allow" },
		{ "action": "shell", "resource": "npx prettier*", "effect": "allow" },
		{ "action": "shell", "resource": "npx eslint*", "effect": "allow" },
		{ "action": "shell", "resource": "npx ruff*", "effect": "allow" },
		{ "action": "shell", "resource": "go fmt*", "effect": "allow" },
		{ "action": "shell", "resource": "cargo fmt*", "effect": "allow" },
		{ "action": "shell", "resource": "black*", "effect": "allow" },
		{ "action": "shell", "resource": "ruff format*", "effect": "allow" },
		{ "action": "shell", "resource": "rustfmt*", "effect": "allow" },
		{ "action": "shell", "resource": "git log*", "effect": "allow" },
		{ "action": "shell", "resource": "git diff*", "effect": "allow" },
		{ "action": "shell", "resource": "git status*", "effect": "allow" },
		{ "action": "shell", "resource": "git show*", "effect": "allow" },
		{ "action": "shell", "resource": "git blame*", "effect": "allow" },
		{ "action": "shell", "resource": "git grep*", "effect": "allow" },
		{ "action": "shell", "resource": "git ls-files*", "effect": "allow" },
		{ "action": "shell", "resource": "git ls-tree*", "effect": "allow" },
		{ "action": "shell", "resource": "git ls-remote*", "effect": "allow" },
		{ "action": "shell", "resource": "git cat-file*", "effect": "allow" },
		{ "action": "shell", "resource": "git rev-list*", "effect": "allow" },
		{ "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
		{ "action": "shell", "resource": "git describe*", "effect": "allow" },
		{ "action": "shell", "resource": "git shortlog*", "effect": "allow" },
		{ "action": "shell", "resource": "git reflog*", "effect": "allow" },
		{ "action": "shell", "resource": "git name-rev*", "effect": "allow" },
		{
			"action": "shell",
			"resource": "git for-each-ref*",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "git branch", "effect": "allow" },
		{
			"action": "shell",
			"resource": "git branch --list*",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "git tag", "effect": "allow" },
		{ "action": "shell", "resource": "git tag -l*", "effect": "allow" },
		{ "action": "shell", "resource": "git remote", "effect": "allow" },
		{ "action": "shell", "resource": "git remote -v*", "effect": "allow" },
		{
			"action": "shell",
			"resource": "git remote show*",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "git stash list", "effect": "allow" },
		{
			"action": "shell",
			"resource": "git config --get*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git config --list*",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "echo $*", "effect": "ask" },
		{ "action": "shell", "resource": "env", "effect": "ask" },
		{ "action": "shell", "resource": "printenv", "effect": "ask" },
		{ "action": "shell", "resource": "export", "effect": "ask" },
		{ "action": "shell", "resource": "set", "effect": "ask" },
		{ "action": "shell", "resource": "ps e*", "effect": "ask" },
		{ "action": "shell", "resource": "*.env", "effect": "ask" },
		{ "action": "shell", "resource": "*.env.*", "effect": "ask" },
		{ "action": "shell", "resource": "*.env.example", "effect": "allow" }
	],

	"update": "disable",

	"plugins": ["@cortexkit/opencode-magic-context@0.49.0"],

	"mcp": {
		"servers": {
			"supabase": {
				"type": "remote",
				"url": "http://127.0.0.1:54321/mcp",
				"disabled": true
			},
			"hound": {
				"type": "local",
				"command": ["hound"]
			},
			"playwright": {
				"type": "local",
				"command": ["pnpm", "dlx", "@playwright/mcp@0.0.82"]
			},
			"atlassian": {
				"type": "remote",
				"url": "https://mcp.atlassian.com/v2/mcp"
			}
		}
	},

	"compaction": {
		"auto": false
	}
}
